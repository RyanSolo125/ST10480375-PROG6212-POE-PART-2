@model ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}
<div class="rd-page-header">
    <div>
        <h1 class="rd-page-title">My Profile</h1>
        <p class="text-muted mb-0">View and update your personal information.</p>
    </div>
</div>

<div class="row g-4">
    @* ---------- Profile picture (stored in Azure Blob Storage by the API) ---------- *@
    <div class="col-lg-4">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="mb-3">@Ui.Avatar(Model.ProfilePictureFileName, Model.FullName, "lg")</div>
                <h2 class="rd-card-title mb-0">@Model.FullName</h2>
                <span class="rd-role-tag rd-role-tag-dark">@Model.Role</span>
                <p class="text-muted small mt-2">Member since @Model.CreatedAt.ToString("MMMM yyyy")</p>

                <form asp-action="UploadPicture" method="post" enctype="multipart/form-data" class="text-start mt-3">
                    <label for="picture" class="form-label">Change profile picture</label>
                    <input type="file" id="picture" name="picture" class="form-control mb-2" accept=".jpg,.jpeg,.png,.webp,.gif" required />
                    <div class="form-text mb-2">JPG, PNG, WEBP or GIF, up to 5 MB.</div>
                    <button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-cloud-arrow-up-fill"></i> Upload picture</button>
                </form>
            </div>
        </div>
    </div>

    @* ---------- Personal details ---------- *@
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="rd-section-title">Personal details</h2>
                <form asp-action="Index" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert rd-alert rd-alert-error" role="alert"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" value="@Model.Email" readonly disabled />
                            <div class="form-text">Your email is used to log in and can't be changed.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Account type</label>
                            <input type="text" class="form-control" value="@Model.Role" readonly disabled />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary mt-4"><i class="bi bi-save-fill"></i> Save changes</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
