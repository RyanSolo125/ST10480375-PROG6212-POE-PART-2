@{
    // Who is logged in (stored in the session at login)
    var role = Context.Session.GetString(SessionKeys.Role);
    var fullName = Context.Session.GetString(SessionKeys.FullName);
    var picture = Context.Session.GetString(SessionKeys.ProfilePicture);
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    Func<string, string> active = name => currentController == name ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " | " : "")RaceDay</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;1,700;1,800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="~/img/favicon.svg" type="image/svg+xml" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark rd-navbar sticky-top">
        <div class="container">
            <a class="navbar-brand rd-brand" asp-controller="Home" asp-action="Index">
                <span class="rd-brand-mark"><i class="bi bi-lightning-charge-fill"></i></span>
                RACE<span>DAY</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    @if (role == Roles.Organiser)
                    {
                        @* ----- Organiser menu ----- *@
                        <li class="nav-item"><a class="nav-link @active("Dashboard")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link @active("ManageEvents")@active("Categories")@active("EventEnrolments")@active("EventResults")" asp-controller="ManageEvents" asp-action="Index"><i class="bi bi-calendar-event"></i> My Events</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="ManageEvents" asp-action="Create"><i class="bi bi-plus-circle"></i> New Event</a></li>
                        <li class="nav-item"><a class="nav-link @active("Home")@active("Events")" asp-controller="Home" asp-action="Index"><i class="bi bi-globe2"></i> Browse Events</a></li>
                    }
                    else if (role == Roles.Participant)
                    {
                        @* ----- Participant menu ----- *@
                        <li class="nav-item"><a class="nav-link @active("Home")@active("Events")" asp-controller="Home" asp-action="Index"><i class="bi bi-flag"></i> Events</a></li>
                        <li class="nav-item"><a class="nav-link @active("Enrolments")" asp-controller="Enrolments" asp-action="Index"><i class="bi bi-ticket-perforated"></i> My Enrolments</a></li>
                        <li class="nav-item"><a class="nav-link @active("Results")" asp-controller="Results" asp-action="Index"><i class="bi bi-trophy"></i> My Results</a></li>
                    }
                    else
                    {
                        @* ----- Visitor menu ----- *@
                        <li class="nav-item"><a class="nav-link @active("Home")@active("Events")" asp-controller="Home" asp-action="Index"><i class="bi bi-flag"></i> Events</a></li>
                    }
                </ul>

                @if (role != null)
                {
                    <div class="dropdown">
                        <button class="btn rd-user-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            @Ui.Avatar(picture, fullName, "sm")
                            <span class="ms-2 d-none d-md-inline">@fullName</span>
                            <span class="rd-role-tag ms-2">@role</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person-circle me-2"></i>My Profile</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Log out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <div class="d-flex gap-2">
                        <a class="btn btn-outline-light" asp-controller="Account" asp-action="Login">Log in</a>
                        <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Sign up</a>
                    </div>
                }
            </div>
        </div>
    </nav>

    @RenderSection("Hero", required: false)

    <main class="container py-4 rd-main">
        <partial name="_Alerts" />
        @RenderBody()
    </main>

    <footer class="rd-footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <span class="rd-brand rd-brand-footer">RACE<span>DAY</span></span>
            <span>Find your race. Chase your finish line. &copy; @DateTime.Now.Year RaceDay</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
