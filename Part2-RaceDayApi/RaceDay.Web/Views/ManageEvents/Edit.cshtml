@model EventFormViewModel
@{
    ViewData["Title"] = "Edit " + Model.EventName;
}
<div class="rd-page-header">
    <div>
        <a asp-action="Index" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> My events</a>
        <h1 class="rd-page-title">Edit event</h1>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Categories" asp-action="Index" asp-route-eventId="@Model.EventId" class="btn btn-outline-primary"><i class="bi bi-tags"></i> Categories</a>
        <a asp-controller="EventEnrolments" asp-action="Index" asp-route-eventId="@Model.EventId" class="btn btn-outline-primary"><i class="bi bi-people"></i> Enrolments</a>
        <a asp-controller="EventResults" asp-action="Index" asp-route-eventId="@Model.EventId" class="btn btn-outline-primary"><i class="bi bi-stopwatch"></i> Results</a>
    </div>
</div>

<div class="card">
    <div class="card-body p-4">
        <form asp-action="Edit" asp-route-id="@Model.EventId" method="post" enctype="multipart/form-data" novalidate>
            <input type="hidden" asp-for="ExistingBannerFileName" />
            <partial name="_EventForm" model="Model" />
            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save-fill"></i> Save changes</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <a asp-action="Delete" asp-route-id="@Model.EventId" class="btn btn-outline-danger ms-auto"><i class="bi bi-trash3"></i> Delete event</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
