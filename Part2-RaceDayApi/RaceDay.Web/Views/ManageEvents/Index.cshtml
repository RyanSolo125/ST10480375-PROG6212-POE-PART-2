@model List<EventDto>
@{
    ViewData["Title"] = "My Events";
}
<div class="rd-page-header">
    <div>
        <h1 class="rd-page-title">My Events</h1>
        <p class="text-muted mb-0">Create, edit and manage the events you organise.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New event</a>
</div>

@if (!Model.Any())
{
    <div class="rd-empty">
        <i class="bi bi-calendar-plus"></i>
        <h3>No events yet</h3>
        <p><a asp-action="Create">Create your first event</a>.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var ev in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card rd-event-card h-100">
                    <div class="rd-event-card-banner">
                        <partial name="_EventBanner" model="ev" />
                        <span class="rd-type-pill @Ui.EventTypeClass(ev.EventType)"><i class="bi @Ui.EventTypeIcon(ev.EventType)"></i> @ev.EventType</span>
                        <div class="rd-date-chip">
                            <span class="rd-date-day">@ev.EventDate.ToString("dd")</span>
                            <span class="rd-date-month">@ev.EventDate.ToString("MMM")</span>
                        </div>
                    </div>
                    <div class="card-body">
                        <h3 class="rd-card-title">@ev.EventName</h3>
                        <p class="rd-meta mb-2"><i class="bi bi-geo-alt-fill"></i> @ev.Location &middot; @Ui.Distance(ev.DistanceKm)</p>
                        <div class="d-flex flex-wrap gap-2">
                            <span class="rd-chip"><i class="bi bi-tags-fill"></i> @ev.Categories.Count categories</span>
                            <span class="rd-chip"><i class="bi bi-people-fill"></i> @ev.EnrolmentCount enrolled</span>
                            @if (!ev.IsUpcoming)
                            {
                                <span class="rd-badge rd-badge-neutral">Completed</span>
                            }
                        </div>
                    </div>
                    <div class="card-footer bg-transparent d-flex flex-wrap gap-2">
                        <a asp-action="Edit" asp-route-id="@ev.EventId" class="btn btn-sm btn-primary"><i class="bi bi-pencil-square"></i> Edit</a>
                        <a asp-controller="Categories" asp-action="Index" asp-route-eventId="@ev.EventId" class="btn btn-sm btn-outline-primary">Categories</a>
                        <a asp-controller="EventEnrolments" asp-action="Index" asp-route-eventId="@ev.EventId" class="btn btn-sm btn-outline-primary">Enrolments</a>
                        <a asp-controller="EventResults" asp-action="Index" asp-route-eventId="@ev.EventId" class="btn btn-sm btn-outline-primary">Results</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
