@* Shared by Create and Edit. The banner image goes to the API, which stores it in Azure Blob Storage. *@
@model EventFormViewModel
<div asp-validation-summary="ModelOnly" class="alert rd-alert rd-alert-error" role="alert"></div>
<input type="hidden" asp-for="EventId" />

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="EventName" class="form-label"></label>
        <input asp-for="EventName" class="form-control" placeholder="e.g. Durban City Night Run" />
        <span asp-validation-for="EventName" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="EventType" class="form-label"></label>
        <select asp-for="EventType" class="form-select">
            <option value="Run">Run</option>
            <option value="Walk">Walk</option>
            <option value="Cycle">Cycle</option>
        </select>
        <span asp-validation-for="EventType" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4" placeholder="What should participants know about the route, start time, parking...?"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="EventDate" class="form-label"></label>
        <input asp-for="EventDate" type="date" class="form-control" />
        <span asp-validation-for="EventDate" class="text-danger small"></span>
    </div>
    <div class="col-md-5">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" placeholder="e.g. Durban" />
        <span asp-validation-for="Location" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="DistanceKm" class="form-label"></label>
        <input asp-for="DistanceKm" type="number" step="0.1" min="0.1" class="form-control" />
        <span asp-validation-for="DistanceKm" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="BannerImage" class="form-label"></label>
        <div class="rd-upload-box">
            @if (Model.ExistingBannerFileName != null)
            {
                <img src="@Ui.ImageUrl(Model.ExistingBannerFileName)" alt="Current banner" class="rd-upload-preview" />
            }
            <div class="flex-grow-1">
                <input asp-for="BannerImage" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif" />
                <div class="form-text">
                    JPG, PNG, WEBP or GIF, up to 5 MB.
                    @(Model.ExistingBannerFileName != null ? "Choose a new image to replace the current banner." : "Optional - you can add one later.")
                </div>
            </div>
        </div>
    </div>
</div>
