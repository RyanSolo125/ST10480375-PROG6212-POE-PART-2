@model HomeViewModel
@{
    ViewData["Title"] = "Upcoming Events";
    var role = Context.Session.GetString(SessionKeys.Role);
    var name = Context.Session.GetString(SessionKeys.FullName);
}

@section Hero {
    <section class="rd-hero">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <span class="rd-eyebrow"><i class="bi bi-lightning-charge-fill"></i> Runs &middot; Walks &middot; Rides</span>
                    @if (name != null)
                    {
                        <h1 class="rd-hero-title">Ready to race, <span>@(name.Split(' ')[0])?</span></h1>
                    }
                    else
                    {
                        <h1 class="rd-hero-title">Find your next <span>finish line.</span></h1>
                    }
                    <p class="rd-hero-text">Browse upcoming races across South Africa, pick your category and enter in seconds.</p>
                    @if (role == null)
                    {
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Register">Create a free account</a>
                            <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Login">Log in</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
}

@* ---------- Filters ---------- *@
<form method="get" asp-action="Index" class="rd-filter-bar card mb-4">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-6">
            <label for="search" class="form-label">Search</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" id="search" name="search" value="@Model.Search" class="form-control" placeholder="Event name or location, e.g. Cape Town" maxlength="100" />
            </div>
        </div>
        <div class="col-md-3">
            <label for="type" class="form-label">Event type</label>
            <select id="type" name="type" class="form-select">
                <option value="">All types</option>
                @foreach (var type in new[] { "Run", "Walk", "Cycle" })
                {
                    @Ui.Option(type, type, Model.Type == type)
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-funnel-fill"></i> Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </div>
</form>

<div class="d-flex justify-content-between align-items-baseline mb-3">
    <h2 class="rd-section-title mb-0">Upcoming events</h2>
    <span class="text-muted">@Model.Events.Count @(Model.Events.Count == 1 ? "event" : "events") found</span>
</div>

@if (ViewBag.LoadError != null)
{
    <div class="rd-empty">
        <i class="bi bi-wifi-off"></i>
        <h3>Events can't be loaded right now</h3>
        <p>@ViewBag.LoadError</p>
    </div>
}
else if (!Model.Events.Any())
{
    <div class="rd-empty">
        <i class="bi bi-search"></i>
        <h3>No events match your filters</h3>
        <p>Try a different search or <a asp-action="Index">show all upcoming events</a>.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var ev in Model.Events)
        {
            <partial name="_EventCard" model="ev" />
        }
    </div>
}
