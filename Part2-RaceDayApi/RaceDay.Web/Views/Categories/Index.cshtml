@model CategoriesPageViewModel
@{
    ViewData["Title"] = "Categories - " + Model.Event.EventName;
}
<partial name="_OrganiserEventNav" model="Model.Event" />

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body pb-0"><h2 class="rd-section-title">Age &amp; distance categories</h2></div>
            @if (!Model.Categories.Any())
            {
                <div class="card-body">
                    <p class="text-muted mb-0">No categories yet. Participants can only enter once you add at least one, e.g. <em>Under 20</em>, <em>Senior</em>, <em>10km</em> or <em>21km</em>.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table rd-table align-middle mb-0">
                        <thead>
                            <tr><th>Category</th><th>Distance</th><th>Entry fee</th><th class="text-center">Enrolled</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Categories)
                            {
                                <tr>
                                    <td class="fw-semibold">@c.CategoryName</td>
                                    <td>@Ui.Distance(c.DistanceKm)</td>
                                    <td>@Ui.Money(c.EntryFee)</td>
                                    <td class="text-center">@c.EnrolmentCount@(c.MaxParticipants != null ? " / " + c.MaxParticipants : "")</td>
                                    <td class="text-end text-nowrap">
                                        <a asp-action="Edit" asp-route-id="@c.CategoryId" asp-route-eventId="@Model.Event.EventId" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                        <form asp-action="Delete" asp-route-id="@c.CategoryId" asp-route-eventId="@Model.Event.EventId" method="post" class="d-inline"
                                              data-confirm="Remove the @c.CategoryName category? Its enrolments will also be removed.">
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash3"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h2 class="rd-section-title">Add a category</h2>
                <form asp-action="Create" method="post" novalidate>
                    <input type="hidden" asp-for="NewCategory.EventId" />
                    <div class="mb-3">
                        <label asp-for="NewCategory.CategoryName" class="form-label"></label>
                        <input asp-for="NewCategory.CategoryName" class="form-control" placeholder="e.g. Under 20, Senior, 10km" />
                        <span asp-validation-for="NewCategory.CategoryName" class="text-danger small"></span>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label asp-for="NewCategory.DistanceKm" class="form-label"></label>
                            <input asp-for="NewCategory.DistanceKm" type="number" step="0.1" min="0" class="form-control" />
                            <span asp-validation-for="NewCategory.DistanceKm" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="NewCategory.EntryFee" class="form-label"></label>
                            <input asp-for="NewCategory.EntryFee" type="number" step="0.01" min="0" class="form-control" placeholder="0" />
                            <span asp-validation-for="NewCategory.EntryFee" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewCategory.MaxParticipants" class="form-label"></label>
                        <input asp-for="NewCategory.MaxParticipants" type="number" min="1" class="form-control" placeholder="Leave empty for unlimited" />
                        <span asp-validation-for="NewCategory.MaxParticipants" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-plus-lg"></i> Add category</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
