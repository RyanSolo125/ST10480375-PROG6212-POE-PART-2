@model CategoryFormViewModel
@{
    ViewData["Title"] = "Edit category";
}
<div class="row justify-content-center">
    <div class="col-lg-6">
        <a asp-action="Index" asp-route-eventId="@Model.EventId" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Back to categories</a>
        <h1 class="rd-page-title">Edit category</h1>
        @if (ViewBag.EventName != null)
        {
            <p class="text-muted">@ViewBag.EventName</p>
        }
        <div class="card">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post" novalidate>
                    <input type="hidden" asp-for="CategoryId" />
                    <input type="hidden" asp-for="EventId" />
                    <div class="mb-3">
                        <label asp-for="CategoryName" class="form-label"></label>
                        <input asp-for="CategoryName" class="form-control" />
                        <span asp-validation-for="CategoryName" class="text-danger small"></span>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label asp-for="DistanceKm" class="form-label"></label>
                            <input asp-for="DistanceKm" type="number" step="0.1" min="0" class="form-control" />
                            <span asp-validation-for="DistanceKm" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="EntryFee" class="form-label"></label>
                            <input asp-for="EntryFee" type="number" step="0.01" min="0" class="form-control" />
                            <span asp-validation-for="EntryFee" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label asp-for="MaxParticipants" class="form-label"></label>
                        <input asp-for="MaxParticipants" type="number" min="1" class="form-control" placeholder="Leave empty for unlimited" />
                        <span asp-validation-for="MaxParticipants" class="text-danger small"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-save-fill"></i> Save</button>
                        <a asp-action="Index" asp-route-eventId="@Model.EventId" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
